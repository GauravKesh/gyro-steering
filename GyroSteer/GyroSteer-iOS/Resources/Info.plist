<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>GyroSteer-iOS</string>
    <key>CFBundleIdentifier</key>
    <string>com.gyrosteer.transmitter</string>
    <key>CFBundleName</key>
    <string>GyroSteer</string>
    <key>CFBundleDisplayName</key>
    <string>GyroSteer</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>accelerometer</string>
        <string>gyroscope</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>NSMotionUsageDescription</key>
    <string>GyroSteer uses high-precision gyroscope and motion sensors to track virtual steering wheel rotation in simulators.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>GyroSteer discovers and connects to your Mac over USB cable or Wi-Fi to stream ultra low-latency steering telemetry.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_gyrosteer._udp</string>
    </array>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>GyroSteer uses Bluetooth Low Energy as an offline zero-setup fallback transport when no cable or Wi-Fi is available.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>GyroSteer advertises as a virtual steering wheel peripheral to stream telemetry directly to your Mac.</string>
</dict>
</plist>
